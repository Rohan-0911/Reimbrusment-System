# ==============================================================================
# Reimbursement System — Environment Variables Example
# ==============================================================================
# Copy this file to `.env` in the project root directory and update the values with your local settings.
# Do NOT commit your actual `.env` file containing passwords or secrets.
# ==============================================================================

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=reimburseiq

# Security & Authentication
# Generate a strong, random secret key for production JWT token signing:
SECRET_KEY=change-this-to-a-very-long-secret-key-in-production

# CORS Configuration
# Origin URL of your running frontend (e.g., Live Server or local static server)
FRONTEND_URL=http://localhost:5500

# Optional Currency Exchange Rates
# Optional free API key from https://www.exchangerate-api.com
# Leave empty to automatically use the free open.er-api.com fallback
EXCHANGE_API_KEY=

# Google Gemini API Key (Receipt Scanning & Fraud Scoring)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left empty, the system automatically runs built-in heuristic analysis as a seamless fallback.
GEMINI_API_KEY=
