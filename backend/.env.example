# ─────────────────────────────────────────────────────────────
#  Reimbursement System — Backend Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=reimburseiq

# JWT secret key — change this to a long random string in production
SECRET_KEY=change-this-to-a-very-long-secret-key-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5500

# Optional: exchange rate API key (free tier at exchangerate-api.com)
# Leave empty to use the free open.er-api.com fallback
EXCHANGE_API_KEY=

# Google Gemini API Key (Receipt Scanning, Auto-Fill & Fraud Scoring)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left empty, the system automatically uses built-in heuristic analysis.
GEMINI_API_KEY=
